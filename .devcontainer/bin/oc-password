#!/usr/bin/env bash
# Print the OpenCode server password generated for this container.
set -euo pipefail

FILE="${HOME}/.config/opencode/.server-password"

if [ -n "${OPENCODE_PASSWORD:-}" ]; then
  printf '%s\n' "$OPENCODE_PASSWORD"
elif [ -s "$FILE" ]; then
  cat "$FILE"
  echo
else
  echo "No password yet. Run: bash .devcontainer/start-opencode.sh" >&2
  exit 1
fi
